# target to generate assembly for a file
ui/mainwindow.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\game.dir\build.make CMakeFiles/game.dir/ui/mainwindow.cpp.s
.PHONY : ui/mainwindow.cpp.s

